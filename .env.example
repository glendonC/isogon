# Isogon Environment Template (Pre-Event Specification Only)
# Populate locally in .env ONLY after official NASA Space Apps start (Nov 14, 2026 09:00 local time).
# Never commit .env or expose credentials in client bundles or logs.

# NASA FIRMS Area & Availability API Key (request at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# NASA Earthdata Login Bearer Token (for LPCLOUD MOD14A1 / MYD14A1 / VNP14A1 / VJ114A1 / VJ214A1 tiles)
EARTHDATA_TOKEN=
